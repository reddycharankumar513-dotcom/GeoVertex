# ==============================================================================
# GeoVertex Environment Configuration Template
# ==============================================================================
# Rename this file to .env and customize values for your deployment environment.
# In production, DO NOT commit the .env file or credentials to version control.

# Application Core
PROJECT_NAME="GeoVertex Cadastral Intelligence Platform"
ENVIRONMENT="development"  # options: development, staging, production, test
DEBUG=true                 # MUST be false in production
LOG_LEVEL="INFO"           # options: DEBUG, INFO, WARNING, ERROR, CRITICAL
API_V1_STR="/api/v1"

# Security & Authentication
# In production: generate a 64-char key using: openssl rand -hex 32
JWT_SECRET="geovertex-super-secret-jwt-key-change-in-production-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MIN_PASSWORD_LENGTH=8

# Database Connection (PostgreSQL 16 + PostGIS 3.4)
# Docker Compose: postgresql+psycopg://geovertex:geovertex_password@postgres:5432/geovertex_db
# Local SQLite fallback: sqlite+aiosqlite:///./geovertex.db
DATABASE_URL="postgresql+psycopg://geovertex:geovertex_password@localhost:5432/geovertex_db"
DATABASE_URL_SYNC="postgresql+psycopg://geovertex:geovertex_password@localhost:5432/geovertex_db"

# Database Connection Pool Settings (PostgreSQL)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Redis Cache & Background Broker
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Object Storage Backend (Local / AWS S3 / MinIO / Cloudflare R2)
STORAGE_BACKEND="local"    # options: local, s3, minio
STORAGE_LOCAL_DIR="uploads"
S3_ENDPOINT_URL=""         # e.g., http://minio:9000 or https://s3.us-east-1.amazonaws.com
S3_BUCKET_NAME="geovertex-documents"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"
S3_USE_SSL=true

# Prometheus Metrics & Observability
METRICS_ENABLED=true
PROMETHEUS_METRICS_PATH="/metrics"

# Email / Notification Delivery (Phase 13 / 15)
# When SMTP is unset, the system safely uses ConsoleEmailProvider
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="notifications@geovertex.gov"
SMTP_TLS=true

# CORS Configuration (Comma-separated allowed origins)
# In production: replace with exact authoritative domain(s)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Admin Seed Account (Initial bootstrap)
DEFAULT_ADMIN_EMAIL="admin@geovertex.local"
DEFAULT_ADMIN_PASSWORD="GeoVertexAdmin2026!"
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_FULL_NAME="System Administrator"
