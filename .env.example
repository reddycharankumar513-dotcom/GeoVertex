# GeoVertex Environment Configuration

# Application
PROJECT_NAME="GeoVertex Cadastral Intelligence Platform"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"

# Security & Authentication
# Generate secure keys in production: openssl rand -hex 32
JWT_SECRET="geovertex-super-secret-jwt-key-change-in-production-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + PostGIS)
# For local Docker Compose: postgresql+psycopg://geovertex:geovertex_password@postgres:5432/geovertex_db
# For local host testing: sqlite+aiosqlite:///./geovertex_test.db or local postgres
DATABASE_URL="postgresql+psycopg://geovertex:geovertex_password@localhost:5432/geovertex_db"

# Redis Cache & Message Broker
REDIS_URL="redis://localhost:6379/0"

# CORS
# Comma-separated allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Admin Seed Account (Used by seed script for initial setup)
DEFAULT_ADMIN_EMAIL="admin@geovertex.local"
DEFAULT_ADMIN_PASSWORD="GeoVertexAdmin2026!"
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_FULL_NAME="System Administrator"
