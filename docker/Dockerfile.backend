# ==============================================================================
# GeoVertex Backend Production Dockerfile
# Multi-stage build with Python 3.12, GDAL/PostGIS dependencies & non-root user
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Dependencies
# ------------------------------------------------------------------------------
FROM python:3.12-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /install

# Install build tools and geospatial development libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    gdal-bin \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /install/requirements.txt
RUN pip install --prefix=/install/deps --no-warn-script-location \
    --upgrade pip setuptools wheel && \
    pip install --prefix=/install/deps --no-warn-script-location \
    -r /install/requirements.txt

# ------------------------------------------------------------------------------
# Stage 2: Production Runtime
# ------------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/deps/bin:${PATH}" \
    PYTHONPATH="/app/deps/lib/python3.12/site-packages:/app/backend:${PYTHONPATH}"

WORKDIR /app

# Install runtime shared libraries only (no build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    gdal-bin \
    libgeos-c1v5 \
    libproj25 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create dedicated non-root application user and group
RUN groupadd -g 10001 geovertex && \
    useradd -u 10001 -g geovertex -s /bin/bash -m geovertex

# Copy installed Python packages from builder
COPY --from=builder /install/deps /app/deps

# Copy application source code
COPY backend /app/backend

# Create upload directory and grant permissions
RUN mkdir -p /app/backend/uploads/documents && \
    chown -R geovertex:geovertex /app

USER geovertex
WORKDIR /app/backend

EXPOSE 8000

# Health check using liveness endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Production ASGI server with dynamic port support (Render/Cloud)
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 4 --no-access-log"]

